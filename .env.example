# Database
DATABASE_URL=postgresql+asyncpg://retail_user:retail_password@postgres:5432/retail_intelligence
CLICKHOUSE_URL=clickhouse://default@clickhouse:9000/retail_intelligence

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# AWS S3 (or local storage in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=retail-intelligence-datasets
AWS_S3_REGION=us-east-1
USE_LOCAL_STORAGE=true

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@retailintelligence.com

# FastAPI
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
DEBUG=true

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
